{
  "name": "ippo-recording-session",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/init-env.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "drive:setup": "node --env-file=.env scripts/setup-drive.mjs",
    "signaling:dev": "wrangler dev --config cloudflare/signaling/wrangler.jsonc",
    "signaling:deploy": "wrangler deploy --config cloudflare/signaling/wrangler.jsonc",
    "native:sync": "npm run build && cap sync",
    "native:ios": "cap open ios",
    "notifications:setup": "node scripts/setup-notifications.mjs"
  },
  "dependencies": {
    "@daruma-ikka/recording-core": "0.1.0",
    "@capacitor/core": "^8.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
