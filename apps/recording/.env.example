# Server only. Do not add a VITE_ prefix to these values.
# HTTPS workers.dev URL printed by signaling:deploy
CF_SIGNALING_URL=
# Same private secret on Vercel and the signaling Worker, at least 32 characters
SIGNALING_SERVICE_SECRET=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Generate two independent random secrets, each at least 32 characters.
APP_SESSION_SECRET=
IPPO_ACCESS_CODE=
# Only the collecting team member connects Google; none of these go to the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional fixed existing folder ID or URL; the operator must select it in Picker.
GOOGLE_DRIVE_TARGET_FOLDER_ID=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
ARCHIVE_LABEL=一歩の記録 収集チーム
# Empty for same-origin Vercel; set to your HTTPS Vercel URL for a native build.
VITE_API_BASE_URL=
# Exact origins, comma separated. Add capacitor://localhost for native testing.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Roll out member calling separately from existing invitation calls.
CALLING_ENABLED=0
# Public-key identity + local phonebook rollout. Legacy CALLING_ENABLED does not enable this.
IDENTITY_CALLING_ENABLED=0
# Eight display names in order: member1, member2, member3 ... member8. Empty uses placeholders.
TEAM_MEMBER_NAMES=
# Generate once with npm run notifications:setup. Keep the private key server-only.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# HTTPS application URL or mailto: address identifying the push sender.
WEB_PUSH_SUBJECT=
# Optional: your own HTTPS origin for opt-in local deployment QA. Disabled when empty.
IPPO_QA_API_ORIGIN=
