{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "ippo-demo-signaling",
  "main": "index.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "CallRoom" }, { "name": "DIRECTORY", "class_name": "ContactDirectory" }, { "name": "IDENTITY_DIRECTORY", "class_name": "IdentityDirectory" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallRoom"] }, { "tag": "v2-contacts", "new_sqlite_classes": ["ContactDirectory"] }, { "tag": "v3-identity", "new_sqlite_classes": ["IdentityDirectory"] }],
  "observability": { "enabled": false }
}
